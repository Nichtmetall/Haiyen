# Weiterleitungen der alten Contao-Adressen
RedirectMatch 301 ^/preise\.html$ /booking/
RedirectMatch 301 ^/team\.html$ /team/
RedirectMatch 301 ^/kontakt\.html$ /kontakt/
RedirectMatch 301 ^/bildergalerie\.html$ /galerie/
RedirectMatch 301 ^/impressum\.html$ /impressum/
RedirectMatch 301 ^/datenschutz\.html$ /datenschutz/

ErrorDocument 404 /404.html

# Browser-Caching: gehashte Next-Assets dauerhaft, Bildvarianten 30 Tage, HTML immer neu validieren
<IfModule mod_headers.c>
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <ElseIf "%{REQUEST_URI} =~ m#^/_img/|\.(webp|jpe?g|png|svg|ico|woff2)$#i">
    Header set Cache-Control "public, max-age=2592000"
  </ElseIf>
  <ElseIf "%{REQUEST_URI} =~ m#(/|\.html)$#">
    Header set Cache-Control "no-cache"
  </ElseIf>
</IfModule>
